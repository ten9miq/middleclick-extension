{
  "name": "MiddleClick+",
  "version": "1.5.1",
  "manifest_version": 3,
  "description": "Middle click option for clickables. Opens detected destinations in a background tab next to the source tab, with ChatGPT sidebar support.",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "webNavigation"
  ],
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "navigation-learning.js",
        "feedback.js",
        "event-analysis-client.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/acorn/acorn.js", "event-analysis.js", "event-analysis-main.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}
