{
  "name": "MiddleClick+",
  "version": "1.1.0",
  "manifest_version": 3,
  "description": "Middle click option for clickables. Opens detected destinations in a background tab next to the source tab.",
  "permissions": [
    "contextMenus",
    "tabs"
  ],
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
