{
  "manifest_version": 3,
  "name": "Temporary MiddleClick Replay Probe",
  "version": "0.0.1",
  "permissions": ["tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
